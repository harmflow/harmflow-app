{
  "apiVersion": "harmflow/v1alpha1",
  "kind": "Task",
  "metadata": {
    "id": "script-complete",
    "name": "Every script section",
    "description": "Every section of the script form, set."
  },
  "spec": {
    "enabled": false,
    "type": "script",
    "script": {
      "command": ["/bin/date", "-u", "+%Y-%m-%d %H:%M"],
      "workingDirectory": "${FORM_REPO}",
      "systems": ["macos", "linux"],
      "environment": {
        "AUDIT_LABEL": "Daily audit",
        "AUDIT_LEVEL": "full"
      }
    },
    "schedule": {
      "cron": "30 6 * * 1-5",
      "timezone": "America/Sao_Paulo",
      "missedRun": {
        "policy": "skip"
      }
    },
    "concurrency": {
      "overlappingRuns": "skip"
    },
    "permissions": {
      "profile": "custom",
      "network": "deny",
      "restrictToWorkspace": false,
      "custom": {
        "allowedTools": ["Read", "Grep"],
        "deniedTools": ["WebFetch"],
        "writablePaths": ["${FORM_REPO}"],
        "readablePaths": ["${FORM_REPO}"]
      }
    },
    "execution": {
      "timeoutMinutes": 45,
      "cancelGraceSeconds": 10
    },
    "notifications": {
      "native": {
        "enabled": false,
        "events": ["execution.failed", "execution.cancelled"]
      }
    }
  }
}
