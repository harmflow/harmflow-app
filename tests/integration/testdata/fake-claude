#!/bin/bash
# A stand-in for the Claude Code CLI that speaks its stream-json format. The task's prompt picks the scenario:
# SCENARIO=ok (default), SCENARIO=quota, SCENARIO=quotausage (a quota after the result line reported usage and cost),
# SCENARIO=slow, SCENARIO=report, SCENARIO=secret.
case "$1" in
  --version) echo "2.1.239 (Claude Code)"; exit 0 ;;
  --help) cat <<'HELP'
Usage: claude [options]
  -p, --print  --output-format <format>  --permission-mode <mode>  --allowedTools <tools...>
  --disallowedTools <tools...>  --append-system-prompt <prompt>  --plugin-dir <path>  --agents <json>  --agent <agent>
  --add-dir <directories...>  --tools <tools...>  --no-session-persistence  --model <model>
  --effort <level>  Effort level for the current session (low, medium, high, xhigh, max)
HELP
    exit 0 ;;
  auth) echo '{"loggedIn": true}'; exit 0 ;;
esac
PROMPT=$(cat)
SCENARIO=ok
[[ "$PROMPT" =~ SCENARIO=([a-z]+) ]] && SCENARIO=${BASH_REMATCH[1]}
echo '{"type":"system","subtype":"init","session_id":"fake-session","model":"claude-haiku-4-5-20251001","permissionMode":"acceptEdits"}'
case "$SCENARIO" in
  quota)
    # A message's usage, repeated on each of its lines as the CLI does, and no result line to settle it.
    for block in thinking tool_use; do
      echo '{"type":"assistant","message":{"id":"msg_q1","model":"claude-haiku-4-5-20251001","content":[{"type":"'"$block"'"}],"usage":{"input_tokens":9,"cache_creation_input_tokens":11511,"cache_read_input_tokens":14129,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":11511},"output_tokens":3}}}'
    done
    echo '{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","rateLimitType":"five_hour","resetsAt":1}}'
    echo '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"Claude AI usage limit reached"}'
    exit 1 ;;
  quotausage)
    echo '{"type":"assistant","message":{"id":"msg_u1","model":"claude-haiku-4-5-20251001","content":[{"type":"text","text":"Working."}],"usage":{"input_tokens":25,"cache_creation_input_tokens":12752,"cache_read_input_tokens":65425,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":12752},"output_tokens":2}}}'
    echo '{"type":"rate_limit_event","rate_limit_info":{"status":"rejected","rateLimitType":"five_hour","resetsAt":1}}'
    echo '{"type":"result","subtype":"error_during_execution","is_error":true,"result":"Claude AI usage limit reached","total_cost_usd":0.0364015,"usage":{"input_tokens":25,"cache_creation_input_tokens":12752,"cache_read_input_tokens":65425,"output_tokens":866,"cache_creation":{"ephemeral_1h_input_tokens":12752,"ephemeral_5m_input_tokens":0}},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":25,"outputTokens":866,"cacheReadInputTokens":65425,"cacheCreationInputTokens":12752,"costUSD":0.0364015}}}'
    exit 1 ;;
  slow)
    sleep 300 &
    echo $! > "$HARMFLOW_EXECUTION_DIR/child.pid"
    echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Bash","input":{"command":"sleep 300","description":"Waiting"}}]}}'
    wait
    exit 0 ;;
  report)
    echo '{"type":"step.started","phase":"testing","message":"Running the tests"}' >> "$HARMFLOW_EXECUTION_DIR/progress.jsonl"
    echo '{"type":"test.completed","status":"passed","message":"12 passed"}' >> "$HARMFLOW_EXECUTION_DIR/progress.jsonl"
    sleep 1.5
    printf '%s' '{"outcome":"completed","summary":"done","workItems":[{"key":"o/r#3","outcome":"completed","pullRequest":{"url":"https://github.com/o/r/pull/4","created":true,"draft":true},"tests":{"status":"passed"}}]}' > "$HARMFLOW_EXECUTION_DIR/report.json" ;;
  secret)
    TOKEN="ghp_$(printf 'x%.0s' {1..36})"
    echo "warning: signing in with $TOKEN" >&2
    echo '{"type":"assistant","message":{"content":[{"type":"text","text":"Pushed with '"$TOKEN"'"}]}}'
    # The token in a command and in the final text, which the record keeps as its commands and summary.
    echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t2","name":"Bash","input":{"command":"git push https://x-access-token:'"$TOKEN"'@github.com/o/r","description":"Push"}}]}}'
    echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t2","content":"pushed","is_error":false}]}}'
    echo '{"type":"result","subtype":"success","is_error":false,"result":"Pushed with '"$TOKEN"'","session_id":"fake-session"}'
    exit 0 ;;
esac
echo '{"type":"assistant","message":{"content":[{"type":"tool_use","id":"t1","name":"Bash","input":{"command":"echo hi","description":"Say hi"}}]}}'
echo '{"type":"user","message":{"content":[{"type":"tool_result","tool_use_id":"t1","content":"hi","is_error":false}]}}'
echo '{"type":"assistant","message":{"content":[{"type":"text","text":"All done."}]}}'
echo '{"type":"result","subtype":"success","is_error":false,"result":"All done.","session_id":"fake-session","total_cost_usd":0.0364015,"usage":{"input_tokens":25,"cache_creation_input_tokens":12752,"cache_read_input_tokens":65425,"output_tokens":866,"cache_creation":{"ephemeral_1h_input_tokens":12752,"ephemeral_5m_input_tokens":0}},"modelUsage":{"claude-haiku-4-5-20251001":{"inputTokens":25,"outputTokens":866,"cacheReadInputTokens":65425,"cacheCreationInputTokens":12752,"costUSD":0.0364015}}}'
