{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HarmFlow",
  "version": "0.1.0",
  "identifier": "com.harmflow.desktop",
  "build": {
    "beforeDevCommand": "pnpm -C ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm -C ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "HarmFlow",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#06080d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Schedules, runs, and monitors the agent harnesses on your machine.",
    "copyright": "Copyright © 2026 Leonardo Piedade",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/harmflowd"],
    "resources": {
      "../../agents/": "builtins/agents/",
      "../../skills/": "builtins/skills/",
      "../../templates/": "builtins/templates/"
    },
    "macOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
