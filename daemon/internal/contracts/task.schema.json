{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harmflow.com/schemas/v1alpha1/task.schema.json",
  "title": "HarmFlow task",
  "description": "One general-purpose automation, stored as one YAML file per task. Keys are camelCase, closed-set values snake_case, identifiers of named things kebab-case.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "harmflow/v1alpha1"
    },
    "kind": {
      "const": "Task"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "identifier": {
      "description": "Kebab-case identifier of a named thing: task, task type, harness, agent, skill.",
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        }
      }
    },
    "taskType": {
      "description": "github works GitHub repositories and takes their targets and per-cycle limits; general takes no type parameters; script runs a program of the user's instead of a harness session. A file that still names the type github-issue-implementation, or its block githubIssueImplementation, loads as github, and saving it writes the new names.",
      "type": "string",
      "enum": [
        "github",
        "general",
        "script"
      ]
    },
    "spec": {
      "description": "Every type but script needs a prompt and a harness; a script task takes neither, nor agents, skills, or a workspace.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "type": {
          "$ref": "#/$defs/taskType"
        },
        "prompt": {
          "description": "The instructions given to the harness at the start of each execution.",
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "description": "The agent the prompt was copied from, and a hash of what was copied. An origin only: the task never runs that agent, and an agent that no longer exists is not an error.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "agent",
            "hash"
          ],
          "properties": {
            "agent": {
              "$ref": "#/$defs/identifier"
            },
            "hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        },
        "agents": {
          "description": "Agents cited by name: built-in ones carry the hf- prefix, the user's live in the harness configuration. Each one is available to the session as a subagent; none is its main agent.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true
        },
        "workspace": {
          "$ref": "#/$defs/workspace"
        },
        "schedule": {
          "$ref": "#/$defs/schedule"
        },
        "concurrency": {
          "$ref": "#/$defs/concurrency"
        },
        "harness": {
          "$ref": "#/$defs/harness"
        },
        "permissions": {
          "$ref": "#/$defs/permissions"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "notifications": {
          "$ref": "#/$defs/notifications"
        },
        "github": {
          "$ref": "#/$defs/github"
        },
        "script": {
          "$ref": "#/$defs/script"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "script"
              }
            }
          },
          "then": {
            "required": [
              "script"
            ],
            "properties": {
              "prompt": false,
              "origin": false,
              "agents": false,
              "skills": false,
              "workspace": false,
              "harness": false,
              "github": false
            }
          },
          "else": {
            "required": [
              "prompt",
              "harness"
            ],
            "properties": {
              "script": false
            }
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "github"
              }
            }
          },
          "then": {
            "required": [
              "github"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "general"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "github"
              ]
            }
          }
        }
      ]
    },
    "workspace": {
      "description": "Where the harness session works. A path may use ${VARIABLE} references and ~.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "schedule": {
      "description": "A 5-field cron expression, a cron macro, or a simple interval, never both; no seconds field. A task with no schedule runs only by manual trigger.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cron": {
          "description": "A 5-field cron expression, or one of the macros @yearly, @annually, @monthly, @weekly, @daily, @midnight, and @hourly, in lowercase.",
          "type": "string",
          "pattern": "^\\s*(@(yearly|annually|monthly|weekly|daily|midnight|hourly)|\\S+(\\s+\\S+){4})\\s*$"
        },
        "interval": {
          "description": "A whole number of minutes, hours, or days, such as 30m, 2h, or 1d.",
          "type": "string",
          "pattern": "^[1-9][0-9]*(m|h|d)$"
        },
        "timezone": {
          "description": "IANA time zone; the system's when absent.",
          "type": "string",
          "minLength": 1
        },
        "missedRun": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "enum": [
                "run_on_resume",
                "skip"
              ],
              "default": "run_on_resume"
            }
          }
        }
      },
      "not": {
        "required": [
          "cron",
          "interval"
        ]
      }
    },
    "concurrency": {
      "description": "One execution per task. A firing that arrives while the task runs waits or is skipped.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "overlappingRuns": {
          "type": "string",
          "enum": [
            "queue",
            "skip"
          ],
          "default": "queue"
        }
      }
    },
    "harnessProvider": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "harnessProfile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider"
      ],
      "properties": {
        "provider": {
          "$ref": "#/$defs/harnessProvider"
        },
        "model": {
          "description": "A model the installed harness accepts; default leaves the harness's own default.",
          "type": "string",
          "minLength": 1,
          "default": "default"
        },
        "effort": {
          "description": "A reasoning effort the installed harness accepts; default leaves the harness's own default. Translated per adapter.",
          "type": "string",
          "minLength": 1,
          "default": "default"
        }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preferred"
      ],
      "properties": {
        "preferred": {
          "$ref": "#/$defs/harnessProfile"
        },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "on": {
              "description": "What triggers a failover. Rate limits retry on the same harness.",
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "quota_exhausted",
                  "harness_unavailable"
                ]
              },
              "uniqueItems": true,
              "default": [
                "quota_exhausted",
                "harness_unavailable"
              ]
            },
            "candidates": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/harnessProfile"
              }
            },
            "maxSwitches": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 1
            }
          }
        }
      }
    },
    "permissions": {
      "description": "Translated to each harness's native controls; a restriction a harness cannot enforce runs with a policy.unenforced warning.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "read_only",
            "workspace_write",
            "custom"
          ],
          "default": "workspace_write"
        },
        "restrictToWorkspace": {
          "type": "boolean",
          "default": true
        },
        "network": {
          "type": "string",
          "enum": [
            "allow",
            "deny"
          ],
          "default": "allow"
        },
        "custom": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "allowedTools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "deniedTools": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            },
            "writablePaths": {
              "description": "Each takes ~ and ${VARIABLE}, and must lead inside the home folder, a mounted volume, or an allowed folder of Settings, and into no place a harness may not write.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "timeoutMinutes": {
          "description": "Covers the whole execution, shared by all its attempts.",
          "type": "integer",
          "minimum": 1,
          "maximum": 1440,
          "default": 60
        },
        "cancelGraceSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 600,
          "default": 30
        },
        "rateLimit": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 5
            },
            "initialWaitSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3600,
              "default": 60
            },
            "maxWaitSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400,
              "default": 900
            }
          }
        }
      }
    },
    "notifiableEvent": {
      "description": "Event types a task may be notified about; the names of event.schema.json.",
      "type": "string",
      "enum": [
        "execution.started",
        "execution.completed",
        "execution.failed",
        "execution.cancelled",
        "execution.needs_attention",
        "pull_request.created",
        "pull_request.updated",
        "test.failed",
        "harness.unavailable",
        "harness.no_alternative"
      ]
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "native": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/notifiableEvent"
              },
              "uniqueItems": true,
              "default": [
                "execution.completed",
                "execution.failed",
                "execution.needs_attention",
                "pull_request.created",
                "harness.no_alternative"
              ]
            }
          }
        }
      }
    },
    "repositoryTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "localPath"
      ],
      "properties": {
        "name": {
          "description": "owner/repo on GitHub.",
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "localPath": {
          "type": "string",
          "minLength": 1
        },
        "baseBranch": {
          "type": "string",
          "minLength": 1,
          "default": "main"
        }
      }
    },
    "github": {
      "description": "Parameters of the github type: the repositories a task works and its per-cycle limits. What it does in them — which issues or pull requests it works, and how — is written in its prompt, agents, and skills; there is no filter syntax.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repositories"
      ],
      "properties": {
        "repositories": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/repositoryTarget"
          },
          "minItems": 1
        },
        "queue": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ordering": {
              "type": "string",
              "enum": [
                "oldest_first",
                "newest_first"
              ],
              "default": "oldest_first"
            },
            "maxDiscoveredPerCycle": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 10
            },
            "maxItemsPerCycle": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 1
            },
            "resumeStrategy": {
              "type": "string",
              "enum": [
                "resume_first",
                "new_first",
                "alternate"
              ],
              "default": "resume_first"
            },
            "maxResumeAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 3
            },
            "maxFailedRetries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20,
              "default": 3
            }
          }
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "testRepairAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 2
            }
          }
        }
      }
    },
    "argumentList": {
      "description": "A program and its arguments, started with no shell, so no argument is expanded or split. The program, first, is a name looked up on the PATH of its environment or an absolute path, never a relative one, and alone takes ~ and ${VARIABLE}.",
      "type": "array",
      "prefixItems": [
        {
          "type": "string",
          "minLength": 1
        }
      ],
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "script": {
      "description": "Parameters of the script type: either command, started directly with no shell, or inline, a script run through its interpreter, never both.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "$ref": "#/$defs/argumentList"
        },
        "inline": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "interpreter",
            "source"
          ],
          "properties": {
            "interpreter": {
              "description": "The interpreter and its arguments; the daemon appends the path of a file in the execution's directory holding the source.",
              "$ref": "#/$defs/argumentList"
            },
            "source": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "workingDirectory": {
          "description": "Where the program starts; the user's home directory when absent. A path may use ${VARIABLE} references and ~.",
          "type": "string",
          "minLength": 1
        },
        "environment": {
          "description": "Variables added to the environment the daemon gives the processes it starts, each replacing one of the same name. Names that start with HARMFLOW_ are HarmFlow's own.",
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
            "not": {
              "pattern": "^HARMFLOW_"
            }
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "systems": {
          "description": "The operating systems the task runs on; every system when absent.",
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "macos",
              "linux",
              "windows"
            ]
          },
          "uniqueItems": true,
          "minItems": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "inline"
          ]
        }
      ],
      "not": {
        "required": [
          "command",
          "inline"
        ]
      }
    }
  }
}
